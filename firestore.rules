rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(campaignId, userId) {
      return /databases/$(database)/documents/campanhas/$(campaignId)/membros/$(userId);
    }

    function campaignPath(campaignId) {
      return /databases/$(database)/documents/campanhas/$(campaignId);
    }

    function isMember(campaignId) {
      return signedIn() && exists(memberPath(campaignId, request.auth.uid));
    }

    function isMaster(campaignId) {
      return isMember(campaignId)
        && get(memberPath(campaignId, request.auth.uid)).data.papel == 'mestre';
    }

    match /campanhas/{campaignId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.inviteCode == campaignId
        && request.resource.data.keys().hasOnly([
          'titulo', 'descricao', 'ownerUid', 'inviteCode', 'criadaEm'
        ])
        && getAfter(memberPath(campaignId, request.auth.uid)).data.papel == 'mestre';

      allow read: if isMember(campaignId);
      allow update: if isMaster(campaignId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.inviteCode == resource.data.inviteCode;
      allow delete: if false;

      match /membros/{userId} {
        allow read: if isMember(campaignId);

        allow create: if signedIn()
          && userId == request.auth.uid
          && (
            (
              request.resource.data.papel == 'mestre'
              && request.resource.data.keys().hasOnly(['papel'])
              && getAfter(campaignPath(campaignId)).data.ownerUid == request.auth.uid
            )
            ||
            (
              request.resource.data.papel == 'jogador'
              && request.resource.data.keys().hasOnly(['papel', 'inviteCode'])
              && request.resource.data.inviteCode == campaignId
              && get(campaignPath(campaignId)).data.inviteCode == campaignId
            )
          );
      }

      match /personagens/{personagemId} {
        allow read: if isMaster(campaignId)
          || (
            isMember(campaignId)
            && resource.data.tipo == 'pj'
          );
        allow create: if isMaster(campaignId)
          && request.resource.data.tipo in ['pj', 'npc'];
        allow update: if isMaster(campaignId)
          && request.resource.data.tipo in ['pj', 'npc'];
        allow delete: if isMaster(campaignId);
      }
    }
  }
}